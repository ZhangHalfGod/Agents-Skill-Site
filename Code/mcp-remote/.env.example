# 复制为 .env（勿提交）。R1 本地示例：
MCP_TOKEN=change*************oken
HOST=127.0.0.1
PORT=3921

# 数据源：优先远程已发布索引；本地开发可改用 MANIFEST_PATH
MANIFEST_URL=http://YOUR_DEPLOYED_HOST/agents-skill/manifest.json
# MANIFEST_PATH=../code/docs/public/manifest.json
# 正文根（get_source_text）：默认同 MANIFEST_PATH 上一级或 Code/code
# DOCS_ROOT=/var/www/agents-skill-site/Code/code
# 无本地文件时可选 HTTP 拉正文（主路径仍应 DOCS_ROOT）
# CONTENT_BASE_URL=http://YOUR_DEPLOYED_HOST/raw
# SOURCE_MAX_CHARS=48000
# CACHE_TTL_MS=60000

# 可选：Nginx 未把 Host 改成 127.0.0.1 时再设，例如：
# ALLOWED_HOSTS=YOUR_DEPLOYED_HOST,127.0.0.1
